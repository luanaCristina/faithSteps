# ---------------------------------------------------------------------------
# YouVersion FaithSteps - Variaveis de Ambiente (exemplo)
# Copie para .env e preencha com valores reais. NUNCA commite o .env.
# ---------------------------------------------------------------------------

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faithsteps
DB_USER=postgres
DB_PASSWORD=postgres

# YouVersion / Bible API
# Solicite sua chave em https://platform.youversion.com/platform/apps
# ATENCAO: mantenha a chave apenas no .env local. Rotacione se for exposta.
YOUVERSION_API_BASE_URL=https://api.youversion.com/v1
YOUVERSION_API_KEY=your_youversion_api_key_here

# Modo de staging: usa endpoints REST mockados quando true
YOUVERSION_USE_MOCK=false

# Gamificacao (regras de XP)
XP_PER_CHAPTER_PT=15
XP_PER_CHAPTER_EN=25

# Regra de Talentos (capitulos lidos necessarios por Biblia doada)
CHAPTERS_PER_BIBLE_DONATION=1189
